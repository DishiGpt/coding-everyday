class Solution {
public:
    int sumDivisibleByK(vector<int>& nums, int k) {
        map<int,int>freq;
        int sum=0;
        for(auto p:nums){
            freq[p]++;
        }
        for(auto p:freq){
            if(p.second%k==0){
                sum+=p.first*p.second;
            }
        }
        return sum;
    }
};
