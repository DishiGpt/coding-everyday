class Solution {
public:
    bool isNStraightHand(vector<int>& hand, int groupSize) {
        int n = hand.size();

        if(n % groupSize != 0)
            return false;

        sort(hand.begin(), hand.end());

        while(!hand.empty()) {

            int start = hand.front();
            hand.erase(hand.begin());

            for(int s = 1; s < groupSize; s++) {

                auto it = find(hand.begin(), hand.end(), ++start);

                if(it == hand.end())
                    return false;

                hand.erase(it);
            }
        }

        return true;
    }
};
