class Solution {
public:
    int alternatingSubarray(vector<int>& nums) {
        int max_length = 0;
        int n = nums.size();
        int length = 1;

        for(int i = 1; i < n; i++) {
            if(length == 1 && nums[i] - nums[i-1] == 1) {
                length = 2;
            }
            else if(length > 1 && 
                    nums[i] - nums[i-1] == (length % 2 == 0 ? -1 : 1)) {
                length++;
            }
            else if(nums[i] - nums[i-1] == 1) {
                length = 2;
            }
            else {
                length = 1;
            }

            max_length = max(max_length, length);
        }

        return max_length == 1 ? -1 : max_length;
    }
};
