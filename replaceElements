class Solution {
public:
    vector<int> replaceElements(vector<int>& arr) {
        int n=arr.size();
        int max_element=arr[n-1];
        for(int i=n-2;i>=0;i--){
            int temp=arr[i];
            arr[i]=max_element;
            max_element=max(max_element,temp);
        }
        arr[n-1]=-1;
        return arr;
    }
};
