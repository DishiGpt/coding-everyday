class Solution {
public:
    int surfaceArea(vector<vector<int>>& grid) {
        int n = grid.size();
        int area = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int h = grid[i][j];

                if (h == 0) continue;

                // Surface area of this tower alone
                area += 4 * h + 2;

                // Remove hidden faces with the upper neighbor
                if (i > 0) {
                    area -= 2 * min(h, grid[i - 1][j]);
                }

                // Remove hidden faces with the left neighbor
                if (j > 0) {
                    area -= 2 * min(h, grid[i][j - 1]);
                }
            }
        }

        return area;
    }
};
