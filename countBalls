class Solution {
public:
    int countBalls(int lowLimit, int highLimit) {
        map<int,int>freq;
        for(int i=lowLimit;i<=highLimit;i++){
            int temp=i,sum=0;
            while(temp>0){
                sum+=temp%10;
                temp/=10;
            }
            freq[sum]++;
        }
        int count=INT_MIN;
        for(auto p:freq){
            count=max(count,p.second);
        }
        return count;
    }
};
