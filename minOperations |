class Solution {
public:
    int minOperations(vector<string>& logs) {
        int total=0;
        for(int i=0;i<logs.size();i++){
            if(logs[i]=="../"){
                total=max(total-1,0);
            }
            else if(logs[i]=="./"){}
            else{
                total++;
            }

        }
        return total;
    }
};
