class Solution {
public:
    vector<int> countPoints(vector<vector<int>>& points, vector<vector<int>>& queries) {
        vector<int>ret(queries.size());
        for(int j=0;j<queries.size();j++){
            int count=0;
            for(int i=0;i<points.size();i++){
                double n=sqrt((queries[j][0]-points[i][0])*(queries[j][0]-points[i][0])+(queries[j][1]-points[i][1])*(queries[j][1]-points[i][1]));
                if(n<=queries[j][2]){
                    count++;
                }
            }
            ret[j]=count;
        }
        return ret;
    }
};
