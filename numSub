class Solution {
public:
    int numSub(string s) {
        const long long MOD = 1e9 + 7;
        long long count = 0, ans = 0;
        
        for(char c : s) {
            if(c == '1') {
                count++;            // extend the streak
            } else {
                ans = (ans + (count * (count + 1) / 2) % MOD) % MOD;
                count = 0;         // reset on zero
            }
        }
        
        // add contribution of the last streak (if string ends with 1)
        ans = (ans + (count * (count + 1) / 2) % MOD) % MOD;
        
        return ans;
    }
};
