class Solution {
public:
    int nearestValidPoint(int x, int y, vector<vector<int>>& points) {
        int dist=INT_MAX,index=-1;
        for(int i=0;i<points.size();i++){
            int x_i=points[i][0];
            int y_i=points[i][1];
            if(x_i==x){
                int temp=abs(y_i-y);
                if(temp<dist){
                    dist=temp;
                    index=i;
                }
            }
            else if(y_i==y){
                int temp=abs(x_i-x);
                if(temp<dist){
                    dist=temp;
                    index=i;
                }
            }
        }
        return index;
    }
};
