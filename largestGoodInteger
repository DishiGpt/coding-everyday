class Solution {
public:
    string largestGoodInteger(string num) {
        string result = "";
        for (int i = 0; i <= num.size() - 3; i++) {
            if (num[i] == num[i+1] && num[i] == num[i+2]) {
                string triple = num.substr(i, 3);
                if (result == "" || triple > result) {
                    result = triple;
                }
            }
        }
        return result;
    }
};
