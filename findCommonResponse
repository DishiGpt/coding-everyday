class Solution {
public:
    string findCommonResponse(vector<vector<string>>& responses) {
        for(int i=0;i<responses.size();i++){
            map<string,int>freq;
            for(auto ch:responses[i]){
                freq[ch]++;
            }
            vector<string>temp;
            for(auto p:freq){
                temp.push_back(p.first);
            }
            responses[i]=temp;

        }
        map<string,int>freq;
        for(auto response:responses){
            for(auto ch:response){
                freq[ch]++;
            }
        }
        string res;
        int count=INT_MIN;
        for(auto p:freq){
            if(p.second>count){
                count=p.second;
                res=p.first;
            }
        }
        
        return res;
    }
};
