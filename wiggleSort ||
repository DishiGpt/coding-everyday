class Solution {
public:
    void wiggleSort(vector<int>& nums) {
        sort(nums.begin(), nums.end());

        vector<int> temp = nums;

        int n = nums.size();
        int mid = (n - 1) / 2;
        int j = n - 1;

        for (int i = 0; i < n; i += 2) {
            nums[i] = temp[mid--];
        }

        for (int i = 1; i < n; i += 2) {
            nums[i] = temp[j--];
    }
    }
};
