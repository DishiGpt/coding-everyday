class Solution {
public:
    int triangularSum(vector<int>& nums) {
        if(nums.size()<1)return 0;
        while(nums.size()>1){
            int i=0;int n=nums.size();
            vector<int>temp(n-1);
            while(i<n-1){
                temp[i]=(nums[i]+nums[i+1])%10;
                i++;
            }
            nums=temp;
        }
        return nums[0];
    }
};
