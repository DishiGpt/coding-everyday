class Solution {
public:
    int minimumBoxes(vector<int>& apple, vector<int>& capacity) {
        sort(capacity.begin(),capacity.end(),greater<int>());
        int count=0,cap=0,total=0;
        for(int i=0;i<apple.size();i++){
            total+=apple[i];
        }
        for(int i=0;i<capacity.size();i++){
            if(cap<total){
                cap+=capacity[i];
                count++;
            }
        }
        return count;
    }
};
