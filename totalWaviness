class Solution {
public:
    int totalWaviness(int num1, int num2) {
        int count=0;
        if(num2<100){
            return 0;
        }
        for(int i=num1;i<=num2;i++){
            vector<int>digits;
            int temp=i;
            while(temp>0){
                digits.push_back(temp%10);
                temp/=10;
            }
            for(int i=1;i<digits.size()-1;i++){
                if((digits[i]>digits[i-1]&&digits[i]>digits[i+1])||(digits[i]<digits[i-1]&&digits[i]<digits[i+1])){
                    count++;
                }
            }
        }
        return count;
    }
};
