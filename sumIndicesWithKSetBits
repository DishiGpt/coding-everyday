class Solution {
public:
    int sumIndicesWithKSetBits(vector<int>& nums, int k) {
        int res=0;
        for(int i=0;i<nums.size();i++){
            int n=i;
            int count=0;
            while(n>0){
                if(n%2==1){count++;}
                n/=2;
            }
            if(count==k){res+=nums[i];}
        }
        return res;
    }
};
