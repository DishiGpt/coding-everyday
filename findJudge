class Solution {
public:
    int findJudge(int n, vector<vector<int>>& trust) {
        vector<int>indegree(n),outdegree(n);
        for(int i=0;i<trust.size();i++){
            outdegree[trust[i][0]-1]++;
            indegree[trust[i][1]-1]++;
        }
        for(int i=0;i<n;i++){
            if(outdegree[i]==0){
                if(indegree[i]==n-1)return i+1;
            }
        }
        return -1;
    }
};
