class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int area=INT_MIN;
        int n=heights.size();
        vector<int>left(n),right(n);
        stack<int>index;
        left[0]=-1;
        right[n-1]=n;
        for(int i=0;i<n;i++){
            if(index.empty()){
                left[i]=-1;
                index.push(i);
            }
            else if(heights[index.top()]<heights[i]){
                left[i]=index.top();
                index.push(i);
            }
            else{
                while(!index.empty()&&heights[index.top()]>=heights[i]){
                    index.pop();
                }
                if(index.empty()){
                    left[i]=-1;
                    index.push(i);
                }
                else{
                    left[i]=index.top();
                    index.push(i);
                }
                
            }
        }
        index=stack<int>();
        for(int i=n-1;i>=0;i--){
            if(index.empty()){
                right[i]=n;
                index.push(i);
            }
            else if(heights[index.top()]<heights[i]){
                right[i]=index.top();
                index.push(i);
            }
            else{
                while(!index.empty()&&heights[index.top()]>=heights[i]){
                    index.pop();
                }
                if(index.empty()){
                    right[i]=n;
                    index.push(i);
                }
                else{
                    right[i]=index.top();
                    index.push(i);
                }
                
            }
        }
        for(int i=0;i<n;i++){
            area=max(area,heights[i]*abs(right[i]-left[i]-1));
        }
        return area;
    }
};
