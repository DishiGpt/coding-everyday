class Solution {
public:
    int findKOr(vector<int>& nums, int k) {
        int n = nums.size();
        int res = 0;

        for(int i = 0; i < 32; i++) {
            int count = 0;

            for(int j = 0; j < n; j++) {
                if((nums[j] >> i) & 1) {
                    count++;
                }
            }

            if(count >= k) {
                res |= (1 << i);
            }
        }

        return res;
    }
};
