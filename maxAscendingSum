class Solution {
public:
    int maxAscendingSum(vector<int>& nums) {
        int sum=nums[0];
        int temp_sum=nums[0];
        for(int right=1;right<nums.size();right++){
            if(nums[right]>nums[right-1]){
                temp_sum+=nums[right];
            }
            else{
                temp_sum=nums[right];
            }
            sum=max(sum,temp_sum);
        }
        return sum;
    }
};
