class Solution {
public:
    string removeDigit(string number, char digit) {
        int idx=-1;int n=number.size();
        for(int i=0;i<n;i++){
            if(number[i]==digit){
                if(i<n&&number[i+1]>digit){
                    number.erase(i,1);
                    return number;
                }
                else{
                    idx=i;
                }
            }
        }
        number.erase(idx,1);
        return number;
    }
};
