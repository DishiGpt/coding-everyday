class Solution {
public:
    int totalHammingDistance(vector<int>& nums) {
        int total = 0;
        int n = nums.size();
        
        for (int i = 0; i < 32; i++) {
            int countOnes = 0;
            for (int num : nums) {
                if (num & (1 << i)) {
                    countOnes++;
                }
            }
            total += countOnes * (n - countOnes);
        }
        
        return total;
    }
};
