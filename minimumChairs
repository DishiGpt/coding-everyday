class Solution {
public:
    int minimumChairs(string s) {
        int ans=INT_MIN;int var=0;
        for(int i=0;i<s.size();i++){
            if(s[i]=='E'){
                var++;
                ans=max(ans,var);
            }
            else{
                var--;
                ans=max(ans,var);
            }
        }
        return ans;
    }
};
