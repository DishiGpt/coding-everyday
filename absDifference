class Solution {
public:
    int absDifference(vector<int>& nums, int k) {
        sort(nums.begin(),nums.end());
        int sum_s=0,sum_l=0;
        int i=0,temp=0;
        while(temp<k){
            sum_s+=nums[i++];
            temp++;
        }
        i=nums.size()-1,temp=0;
        while(temp<k){
            sum_l+=nums[i--];
            temp++;
        }
        return abs(sum_l-sum_s);
    }
};
