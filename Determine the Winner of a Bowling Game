class Solution {
public:
    int isWinner(vector<int>& player1, vector<int>& player2) {
        int p1=player1[0],p2=player2[0];
        int n=player1.size();
        for(int i=1;i<n;i++){
            {   
                if((i==1&&player1[i-1]==10)||(i>=2&&(player1[i-1]==10||player1[i-2]==10))){
                    p1+=player1[i]*2;
                }
                else{
                    p1+=player1[i];
                }   
            }
            {
                if((i==1&&player2[i-1]==10)||(i>=2&&(player2[i-1]==10||player2[i-2]==10))){
                    p2+=player2[i]*2;
                }
                else{
                    p2+=player2[i];
                }
            }
        }
        if(p1>p2)return 1;
        else if(p2>p1)return 2;
        return 0;
    }
};
