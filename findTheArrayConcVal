class Solution {
public:
    long long findTheArrayConcVal(vector<int>& nums) {
        int n=nums.size();
        int left=0,right=n-1;
        long long val=0;
        while(left<=right){
            if(left==right){
                val+=nums[left];
                break;
            }
            else{
                int temp=0;
                int digits=1;
                int hold=nums[right];
                while(hold>0){
                    digits*=10;
                    hold/=10;
                }
                temp=nums[left]*digits+nums[right];
                val+=temp;
                left++;
                right--;
            }
        }
        return val;
    }
};
