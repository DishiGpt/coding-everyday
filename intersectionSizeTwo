class Solution {
public:
    int intersectionSizeTwo(vector<vector<int>>& intervals) {
        if (intervals.empty()) return 0;
        sort(intervals.begin(), intervals.end(), [](const vector<int>& a, const vector<int>& b){
            if (a[1] == b[1]) return a[0] > b[0]; // same end -> larger start first
            return a[1] < b[1]; // smaller end first
        });

        int s1 = INT_MIN, s2 = INT_MIN; // s1 < s2 are last two chosen numbers
        int ans = 0;
        for (auto &it : intervals) {
            int l = it[0], r = it[1];
            if (s2 < l) {
                // none of s1,s2 in [l,r] -> add two: r-1, r
                ans += 2;
                s1 = r - 1;
                s2 = r;
            } else if (s1 < l && s2 >= l) {
                // exactly one of s1,s2 in [l,r] -> add one: r
                ans += 1;
                s1 = s2;
                s2 = r;
            } else {
                // both s1 and s2 are already in [l,r] -> do nothing
            }
        }
        return ans;
    }
};
