struct TrieNode{
        bool isEnd;
        TrieNode * children[26];

        TrieNode() {
            isEnd = false;
            for (int i = 0; i < 26; i++) {
                children[i] = nullptr;
            }
        }
    };

class Trie {
    TrieNode * root;
public:
    Trie() {
        root= new TrieNode();
    }
    
    void insert(string word) {
        int i=0;
        TrieNode * temp=root;
        while(i<word.length()){
            if(temp->children[word[i]-'a']==nullptr){
                temp->children[word[i]-'a']=new TrieNode();
            }
            temp=temp->children[word[i]-'a'];
            i++;
        }
        temp->isEnd=true;
    }
    
    bool search(string word) {
        int i=0;
        TrieNode * temp=root;
        while(i<word.length()){
            if(temp->children[word[i]-'a']==nullptr){
                return false;
            }
            temp=temp->children[word[i]-'a'];
            i++;
        }
        return temp->isEnd==true;
    }
    
    bool startsWith(string prefix) {
        int i=0;
        TrieNode * temp=root;
        while(i<prefix.length()){
            if(temp->children[prefix[i]-'a']==nullptr){
                return false;
            }
            temp=temp->children[prefix[i]-'a'];
            i++;
        }
        return true;
    }
};

