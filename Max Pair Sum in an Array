class Solution {
public:
    int maxSum(vector<int>& nums) {
        int n=nums.size();
        vector<int>largest(n);
        for(int i=0;i<n;i++){
            string temp=to_string(nums[i]);
            sort(temp.begin(),temp.end());
            largest[i]=temp.back()-'0';
        }
        int largest_sum=INT_MIN;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(largest[i]==largest[j]){
                    int temp=nums[i]+nums[j];
                    largest_sum=max(largest_sum,temp);
                }
            }
        }
        return (largest_sum == INT_MIN) ? -1 : largest_sum;
    }
};
