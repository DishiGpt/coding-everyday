class Solution {
public:
    vector<int> maxKDistinct(vector<int>& nums, int k) {
        map<int,int>freq;
        vector<int>ans;
        for(auto n:nums){
            freq[n]++;
        }
        for (auto it = freq.rbegin(); it != freq.rend(); it++) {
            if(k<=0)break;
            else{
                k--;
                ans.push_back(it->first);
            }
        }
        return ans;
    }
};
