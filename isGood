class Solution {
public:
    bool isGood(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int n=nums.size();
        int max=nums[n-1];
        map<int,int>freq;
        for(int i=0;i<n;i++){
            freq[nums[i]]++;
        }
        auto it=freq.begin();
        for(it ; it != prev(freq.end()); ++it){
            if(it->second!=1)return false;
        }
        return it->second==2 && n-1==max;
    }
};
