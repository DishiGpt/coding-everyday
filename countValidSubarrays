class Solution {
public:
    int countValidSubarrays(vector<int>& nums, int x) {
        int n = nums.size();
        if (n == 0) return 0;

        vector<long long> prefix(n, 0);
        prefix[0] = nums[0];
        for(int i = 1; i < n; i++){
            prefix[i] = prefix[i-1] + nums[i];
        }

        int ans = 0;

        for(int i = 0; i < n; i++){
            for(int j = i; j < n; j++){
                long long sum = prefix[j] - (i == 0 ? 0 : prefix[i-1]);
                long long abs_sum = abs(sum); 
                
                if (abs_sum % 10 == x) {
                    string num = to_string(abs_sum);
                    if (num[0] - '0' == x) {
                        ans++;
                    }
                }
            }
        }
        return ans;
    }
};©leetcode
