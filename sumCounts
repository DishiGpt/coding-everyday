class Solution {
public:
    int sumCounts(vector<int>& nums) {
        int n = nums.size();
        int total=0;
    for (int i = 0; i < n; i++) {
        for (int j = i; j < n; j++) {
            map<int,int>freq;
            for (int k = i; k <= j; k++) {
                freq[nums[k]]++;
            }
            total+=freq.size()*freq.size();
        }
    }
    return total;
    }
};
