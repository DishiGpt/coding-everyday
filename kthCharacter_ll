class Solution {
    
public:
    
    char kthCharacter(long long k, vector<int>& operations) {
        long long length = 1;
        int opsNeeded = 0;
        
        while (length < k && opsNeeded < operations.size()) {
            length *= 2;
            opsNeeded++;
        }
        
        long long pos = k;
        int totalShifts = 0;
        
        for (int i = opsNeeded - 1; i >= 0; i--) {
            long long halfLength = 1LL << i;
            
            if (pos > halfLength) {
                pos -= halfLength;
                if (operations[i] == 1) {
                    totalShifts++;
                }
            }
            
        }
        
        return 'a' + (totalShifts % 26);
    }
};
