class Solution {
public:
    int minPairSum(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int i=0,n=nums.size()-1;int sum=0;
        while(i<nums.size()/2){
            int temp=nums[i]+nums[n];
            sum=max(sum,temp);
            i++;
            n--;
        }
        return sum;
    }
};
