class Solution {
public:
    int findUnsortedSubarray(vector<int>& nums) {
        vector<int>copy=nums;
        sort(nums.begin(),nums.end());
        if(copy==nums)return 0;
        int n=nums.size();
        int length=1;
        for(int i=0;i<n;i++){
            if(copy[i]!=nums[i]){
                length-=i;
                break;
            }
        }
        for(int i=n-1;i>=0;i--){
            if(copy[i]!=nums[i]){
                length+=i;
                break;
            }
        }
        return length;
    }
};
