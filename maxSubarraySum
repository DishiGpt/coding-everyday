class Solution {
public:
    long long maxSubarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        vector<long long> minPrefix(k, LLONG_MAX); 
        long long prefix = 0;
        long long ans = LLONG_MIN;

        // Base case: prefix sum at index 0 (empty prefix)
        minPrefix[0] = 0;

        for (int i = 0; i < n; i++) {
            prefix += nums[i];
            int r = (i + 1) % k;

            // If we have seen a prefix with same remainder,
            // compute candidate subarray sum
            if (minPrefix[r] != LLONG_MAX) {
                ans = max(ans, prefix - minPrefix[r]);
            }

            // Update minimum prefix sum for this remainder group
            minPrefix[r] = min(minPrefix[r], prefix);
        }

        return ans;
    }
};
