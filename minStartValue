class Solution {
public:
    int minStartValue(vector<int>& nums) {
        int n=nums.size();
        vector<int>prefix_sum(n);
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=nums[i];
            prefix_sum[i]=sum;
        }
        int req=INT_MAX;
        for(int i=0;i<n;i++){
            req=min(req,prefix_sum[i]);
        }
        if(req<1)return 1-req;
        return 1;
        
    }
};
