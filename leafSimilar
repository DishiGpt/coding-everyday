/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
    vector<int>t1,t2;
public:
    void check1(TreeNode * root){
        if(!root)return;
        check1(root->left);
        if(root->left==nullptr&&root->right==nullptr)t1.push_back(root->val);
        check1(root->right);
    }
    void check2(TreeNode * root){
        if(!root)return;
        check2(root->left);
        if(root->left==nullptr&&root->right==nullptr)t2.push_back(root->val);
        check2(root->right);
    }
    bool leafSimilar(TreeNode* root1, TreeNode* root2) {
        check1(root1);
        check2(root2);
        return t1==t2;
    }
};
