class Solution {
public:
    int countHillValley(vector<int>& nums) {
        int count=0;
        vector<int>temp;
        for(int x:nums){
            if(temp.empty()||temp.back()!=x){
                temp.push_back(x);
            }
        }
        for(int i=1;i<temp.size()-1;i++){
            if((temp[i]>temp[i-1]&&temp[i]>temp[i+1])||(temp[i]<temp[i-1]&&temp[i]<temp[i+1])){
                count++;
            }
        }
        return count;
    }
};
