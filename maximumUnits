class Solution {
public:
    int maximumUnits(vector<vector<int>>& boxTypes, int truckSize) {
        sort(boxTypes.begin(), boxTypes.end(), [](vector<int>& a, vector<int>& b) {
            return a[1] > b[1];
        });
        int count=0;
        int i=0;
        while(truckSize>0 && i<boxTypes.size()){
            if(boxTypes[i][0]>0){
                count+=boxTypes[i][1];
                boxTypes[i][0]--;
                truckSize--;
            }
            else{
                i++;
            }
        }
        return count;
    }
};
