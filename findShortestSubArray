class Solution {
public:
    int findShortestSubArray(vector<int>& nums) {
        unordered_map<int, vector<int>> freq;
        int max_freq = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (freq.find(nums[i]) == freq.end()) {
                // First time seeing this number: freq=1, first_idx=i, last_idx=i
                freq[nums[i]] = {1, i, i};
            } else {
                // Update count and last seen index
                freq[nums[i]][0]++;
                freq[nums[i]][2] = i;
            }
            max_freq = max(max_freq, freq[nums[i]][0]);
        }

        int min_len = nums.size();

        for (auto& entry : freq) {
            int count = entry.second[0];
            int first = entry.second[1];
            int last = entry.second[2];

            if (count == max_freq) {
                min_len = min(min_len, last - first + 1);
            }
        }

        return min_len;
        
    }
};
