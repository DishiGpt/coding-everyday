class Solution {
public:
    void duplicateZeros(vector<int>& arr) {
        int n = arr.size();

        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] == 0) {
            
                for (int j = n - 1; j > i + 1; j--) {
                    arr[j] = arr[j - 1];
                }

                arr[i + 1] = 0;
            }
        }
    }
};
