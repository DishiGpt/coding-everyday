class Solution {
    vector<int>prefix;
    vector<vector<int>> rectangle;

public:
    Solution(vector<vector<int>>& rects) {
        int n=rects.size();
        vector<int>temp(n);
        rectangle=rects;
        int points=0;
        for(int i=0;i<n;i++){
            points+=(rects[i][2]-rects[i][0]+1)*(rects[i][3]-rects[i][1]+1);
            temp[i]=points;
        }
        prefix=temp;
    }
    
    vector<int> pick() {
        int r = rand() % prefix.back() + 1;
        int index = lower_bound(prefix.begin(), prefix.end(), r)- prefix.begin();
        int a = rectangle[index][0];
        int b = rectangle[index][1];
        int x = rectangle[index][2];
        int y = rectangle[index][3];
        return {a + rand() % (x - a + 1),b+ rand() % (y - b + 1)};
    }
};

