class Solution {
public:
    vector<int> arrayRankTransform(vector<int>& arr) {
        map<int,int>freq;
        for(auto a:arr){
            freq[a]++;
        }
        map<int,int>rank;
        int r=0;
        for(auto p:freq){
            rank[p.first]=++r;
        }
        vector<int>ans(arr.size());
        for(int i=0;i<arr.size();i++){
            ans[i]=rank[arr[i]];
        }
        return ans;
    }
};
