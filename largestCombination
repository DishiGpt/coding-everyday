class Solution {
public:
    int largestCombination(vector<int>& candidates) {
        int ans = 0;
        for(int bit = 0; bit < 24; bit++) {
            int count = 0;
            
            for(int num : candidates) {
                if(num & (1 << bit)) {
                    count++;
                }
            }
            
            ans = max(ans, count);
        }
        
        return ans;
    }
};
