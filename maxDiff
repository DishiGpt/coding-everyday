class Solution {
public:
    int maxAdjacentDistance(vector<int>& nums) {
        if(nums.size()<2) return 0;
        int num=abs(nums.front()-nums.back());
        for(int i=0;i<nums.size()-1;i++){
            int temp=abs(nums[i]-nums[i+1]);
            num=max(num,temp);
        }
        return num;
    }
};
