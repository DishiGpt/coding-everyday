class Solution {
public:
    int findLucky(vector<int>& arr) {
        vector<int>result;map<int,int>freq;
        for(auto ch:arr){
            freq[ch]++;
        }
        for(const auto &pair:freq){
            if(pair.first==pair.second)result.push_back(pair.first);
        }
        sort(result.begin(),result.end());
        if(result.empty())return -1;
        return result.back();
    }
};
