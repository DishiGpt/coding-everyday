class Solution {
public:
    int minimumDeletions(string s) {
        int n = s.size();
        vector<int> b(n, 0), a(n, 0);

        // Prefix count of 'b'
        for (int i = 1; i < n; i++) {
            if (s[i - 1] == 'b')
                b[i] = b[i - 1] + 1;
            else
                b[i] = b[i - 1];
        }

        // Suffix count of 'a'
        for (int i = n - 2; i >= 0; i--) {
            if (s[i + 1] == 'a')
                a[i] = a[i + 1] + 1;
            else
                a[i] = a[i + 1];
        }

        int ans = n;
        for (int i = 0; i < n; i++) {
            ans = min(ans, b[i] + a[i]);
        }

        return ans;
    }
};
