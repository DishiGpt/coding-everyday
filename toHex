class Solution {
public:
    string toHex(int num) {
        if (num == 0) return "0";
        
        unsigned int n = num;   // Treat as unsigned for two's complement handling
        string result = "";
        const string hexChars = "0123456789abcdef";
        
        while (n != 0) {
            int digit = n & 0xf;          // Extract last 4 bits
            result = hexChars[digit] + result;
            n >>= 4;                      // Shift right by 4 bits
        }
        
        return result;
    }
};
