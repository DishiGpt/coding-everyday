class Solution {
public:
    vector<vector<int>> diagonalSort(vector<vector<int>>& mat) {
        
        int m = mat.size();
        int n = mat[0].size();
        
        unordered_map<int, vector<int>> mp;
        
        // Step 1: Store elements diagonal-wise
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                mp[i - j].push_back(mat[i][j]);
            }
        }
        
        // Step 2: Sort each diagonal
        for(auto &it : mp){
            sort(it.second.begin(), it.second.end());
        }
        
        // Step 3: Refill matrix with sorted values
        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                int key = i - j;
                mat[i][j] = mp[key].front();
                mp[key].erase(mp[key].begin());
            }
        }
        
        return mat;
    }
};
