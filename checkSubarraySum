class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        map<int, int> div;

        div[0] = -1;  

        int sum = 0;

        for (int i = 0; i < nums.size(); i++) {
            sum += nums[i];

            int rem = sum % k;

            if (div.find(rem) != div.end()) {

                if (i - div[rem] >= 2)
                    return true;

            } else {
                div[rem] = i;
            }
        }

        return false;
    }
};
