class Solution {
public:
    double calculateTax(vector<vector<int>>& brackets, int income) {
        if(income==0)return income;
        double result=0;
        if(income<=brackets[0][0]){
            return (income*brackets[0][1])/100.0;
        }
        else{
            result+=(brackets[0][0]*brackets[0][1])/100.0 ;
            income-=brackets[0][0];
            for(int i=1;i<brackets.size();i++){
                int temp=brackets[i][0]-brackets[i-1][0];
                if(temp>income){
                    temp=income;
                }
                income-=temp;
                result+=(temp*brackets[i][1])/100.0;
            }
        }
        
        return result;
    }
};
