class Solution {
public:
    vector<int> partitionLabels(string s) {
        vector<int>result;
        unordered_map<char, int> last;
        int n=s.size();
        for (int i = 0; i < n; i++) {
            last[s[i]] = i;
        }
        int start=0,end=0;
        for(int i=0;i<n;i++){
            end=max(end,last[s[i]]);
            if(end==i){
                result.push_back(end-start+1);
                start=i+1;
                end=i+1;
            }
        }
        return result;
    }
};
