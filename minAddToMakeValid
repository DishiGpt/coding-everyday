class Solution {
public:
    int minAddToMakeValid(string s) {
        stack<char>st,alt;
        for(int i=0;i<s.size();i++){
            if(s[i]=='('){
                st.push(s[i]);
            }
            else if(!st.empty()&&s[i]==')'){
                st.pop();
            }
            else{
                alt.push(s[i]);
            }
        }
        return st.size()+alt.size();
    }
};
