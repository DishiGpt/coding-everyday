class Solution {
public:
    int minimumMoves(string s) {
        int moves = 0;
        int n = s.size();

        for (int i = 0; i < n; ) {
            if (s[i] == 'X') {
                moves++;
                i += 3;   // This move converts s[i], s[i+1], and s[i+2] to 'O'
            } else {
                i++;
            }
        }

        return moves;
    }
};
