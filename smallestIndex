class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        int count= INT_MAX;
        for(int i=0;i<nums.size();i++){
            int temp=nums[i],sum=0;
            while(temp>0){
                sum+=temp%10;
                temp/=10;
            }
            if(i==sum)count=min(count,i);
        }
        if(count<INT_MAX)return count;
        return -1;
    }
};
