class Solution {
public:
    string destCity(vector<vector<string>>& paths) {
        map<string,int>freq;
        for(int i=0;i<paths.size();i++){
            freq[paths[i][1]]++;
        }
        for(int i=0;i<paths.size();i++){
            if(freq.find(paths[i][0])!=freq.end()){
                freq[paths[i][0]]++;
            }
        }
        string res;
        for(auto pair:freq){
            if(pair.second==1){
                res=pair.first;
                break;
            }
        }
        return res;
    }
};
