class Solution {
public:
    int fillCups(vector<int>& amount) {
        priority_queue<int> pq;

        for (int x : amount) {
            if (x > 0) pq.push(x);
        }

        int seconds = 0;

        while (pq.size() >= 2) {
            int a = pq.top(); pq.pop();
            int b = pq.top(); pq.pop();

            a--;
            b--;
            seconds++;

            if (a > 0) pq.push(a);
            if (b > 0) pq.push(b);
        }

        if (!pq.empty()) {
            seconds += pq.top();
        }

        return seconds;
    }
};
