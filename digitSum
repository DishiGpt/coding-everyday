class Solution {
public:
    string digitSum(string s, int k) {
        while (s.size() > k) {
            string newS = "";
            for (int i = 0; i < s.size(); i += k) {
                string temp = s.substr(i, k);
                int sum = 0;
                for (char c : temp) {
                    sum += c - '0';
                }
                newS += to_string(sum);
            }
            s = newS; 
        }
        return s;
    }
};
