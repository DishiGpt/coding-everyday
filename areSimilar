class Solution {
public:
    bool areSimilar(vector<vector<int>>& mat, int k) {
        int m = mat.size();
        int n = mat[0].size();

        k = k % n;

        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {

                int idx;

                if(i % 2 == 0) {
                    // Even row: left shift
                    idx = (j + k) % n;
                }
                else {
                    // Odd row: right shift
                    idx = (j - k + n) % n;
                }

                if(mat[i][j] != mat[i][idx])
                    return false;
            }
        }

        return true;
    }
};
