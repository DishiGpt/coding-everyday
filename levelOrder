class Solution {
    vector<vector<int>> res;

public:
    void insert(TreeNode* root, int level) {
        if (!root) return;

        if (res.size() < level) {
            res.push_back(vector<int>());
        }

        res[level - 1].push_back(root->val);

        insert(root->left, level + 1);
        insert(root->right, level + 1);
    }

    vector<vector<int>> levelOrder(TreeNode* root) {
        insert(root, 1);
        return res;
    }
};
