class Solution {
public:
    vector<int> twoOutOfThree(vector<int>& nums1, vector<int>& nums2, vector<int>& nums3) {
        vector<int>res;unordered_set<int> set1;
        map<int,int>freq1,freq2,freq3;
        for(auto ch:nums1){
            freq1[ch]++;
        }
        for(auto ch:nums2){
            freq2[ch]++;
        }
        for(auto ch:nums3){
            freq3[ch]++;
        }

        for(auto p:freq1){
            if(freq2.find(p.first)!=freq2.end()){
                set1.insert(p.first);
            }
            if(freq3.find(p.first)!=freq3.end()){
                set1.insert(p.first);
            }
        }
        for(auto p:freq2){
            if(freq3.find(p.first)!=freq3.end()){
                set1.insert(p.first);
            }
        }
        std::vector<int> myVector(set1.begin(), set1.end());
        return myVector;
    }
};
