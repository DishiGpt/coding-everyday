class Solution {
public:
    int minimumPushes(string word) {
        vector<int> freq(26, 0);
        for (char ch : word) {
            freq[ch - 'a']++;
        }

        vector<int> counts;
        for (int f : freq) {
            if (f > 0) counts.push_back(f);
        }

        sort(counts.begin(), counts.end(), greater<int>());

        int total = 0;
        for (int i = 0; i < counts.size(); i++) {
            int cost = (i / 8) + 1;
            total += cost * counts[i];
        }

        return total;
    }
};
