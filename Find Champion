class Solution {
public:
    int findChampion(vector<vector<int>>& grid) {
        map<int,int>ans;
        int n=grid.size();
        for(int i=0;i<n;i++){
            int count=0;
            for(int j=0;j<n;j++){
                if(grid[j][i]==1){
                    count++;
                }
            }
            ans[i]=count;
        }
        int res=INT_MAX,index=0;
        for(auto p:ans){
            if(p.second<res){
                index=p.first;
                res=p.second;
            }
        }
        return index;
    }
};
