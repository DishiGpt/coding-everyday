
class Solution {
public:
    vector<int> circularGameLosers(int n, int k) {
        vector<bool> visited(n, false);

        int curr = 0;
        int i = 1;

        visited[curr] = true;

        while (true) {
            curr = (curr + i * k) % n;

            if (visited[curr]) {
                break;
            }

            visited[curr] = true;
            i++;
        }

        vector<int> ans;

        for (int j = 0; j < n; j++) {
            if (!visited[j]) {
                ans.push_back(j + 1);
            }
        }

        return ans;
    }
};
