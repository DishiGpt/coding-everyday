class Solution {
public:
    vector<int> getNoZeroIntegers(int n) {
        vector<int>res(2);
        for(int i=1;i<=n;i++){
            int x=n-i;bool flag=true;
            while(x){
                if(x%10==0){
                    flag=false;
                    break;
                }
                x/=10;
            }
            int copy=i;
            while(copy){
                if(copy%10==0){
                    flag=false;
                    break;
                }
                copy/=10;
            }
            if(flag){
                res[0]=i;res[1]=n-i;
                break;
            }
        }
        return res;
    }
};
