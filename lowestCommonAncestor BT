/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode(int x) : val(x), left(NULL), right(NULL) {}
 * };
 */
class Solution {
public:
    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {
        if (root==p||root==q)return root;
        TreeNode * leftside=nullptr;TreeNode * rightside=nullptr;
        if(root->left)
        leftside=lowestCommonAncestor(root->left,p,q);
        if(root->right)
        rightside=lowestCommonAncestor(root->right,p,q);
        if(leftside && rightside){
            return root;
        }
        if(leftside)return leftside;
        return rightside;
    }
};
