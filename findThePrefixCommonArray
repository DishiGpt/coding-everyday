class Solution {
public:
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
        int n=A.size();
        vector<int>common(n);
        for(int i=0;i<n;i++){
            map<int,int>freq;
            for(int j=0;j<=i;j++){
                freq[A[j]]++;
                freq[B[j]]++;
            }
            int count=0;
            for(auto pair:freq){
                if(pair.second>1){
                    count++;
                }
            }
            common[i]=count;
        }
        return common;
    }
};
