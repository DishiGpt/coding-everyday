class MyHashSet {
    unordered_map<int,int>nums;
public:
    MyHashSet() {
        
    }
    
    void add(int key) {
        nums[key]++;
    }
    
    void remove(int key) {
        if(nums.find(key)!=nums.end()){
            nums.erase(key);
        }
    }
    
    bool contains(int key) {
       return nums.find(key)!=nums.end();
        
    }
};

