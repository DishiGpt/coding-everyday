class Solution {
public:
    int minNumber(vector<int>& nums1, vector<int>& nums2) {
        sort(nums1.begin(),nums1.end());
        sort(nums2.begin(),nums2.end());
        int n1=nums1.size();
        int n2=nums2.size();
        for(int i=0;i<n1;i++){
            for(int j=0;j<n2;j++){
                if(nums1[i]==nums2[j])return nums1[i];
    
            }
        }
        int p1=min(nums1[0],nums2[0]);
        int p2=max(nums1[0],nums2[0]);
        return p1*10+p2;

    }
};
