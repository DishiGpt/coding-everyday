class Solution {
public:
    int splitNum(int num) {
        int temp=num;
        vector<int>digits;
        while(temp>0){
            digits.push_back(temp%10);
            temp/=10;
        }
        sort(digits.begin(),digits.end());
        int num1=0,num2=0;
        for(int i=0;i<digits.size();i++){
            if(i%2==0){
                num1=num1*10+digits[i];
            }
            else{
                num2=num2*10+digits[i];
            }
        }
        return num1+num2;
    }
};
