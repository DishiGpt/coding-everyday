class Solution {
public:
    int countTime(string time) {
        int hour, minute;

        // Hours
        if (time[0] == '?' && time[1] == '?')
            hour = 24;
        else if (time[0] == '?')
            hour = (time[1] <= '3') ? 3 : 2;
        else if (time[1] == '?')
            hour = (time[0] == '2') ? 4 : 10;
        else
            hour = 1;

        // Minutes
        if (time[3] == '?' && time[4] == '?')
            minute = 60;
        else if (time[3] == '?')
            minute = 6;
        else if (time[4] == '?')
            minute = 10;
        else
            minute = 1;

        return hour * minute;
    }
};
