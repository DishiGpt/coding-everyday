class Solution {
public:
    string oddString(vector<string>& words) {
        int n=words[0].size();
        map<vector<int>,vector<int>>diff;
        string ans;
        for(int i=0;i<words.size();i++){
            vector<int>temp(n-1);
            for(int j=0;j<=n-2;j++){
                temp[j]=words[i][j+1]-words[i][j];
            }
            diff[temp].push_back(i);
        }
        for(auto p:diff){
            if(p.second.size()==1){
                ans=words[p.second.front()];
            }
        }
        return ans;
    }
};
