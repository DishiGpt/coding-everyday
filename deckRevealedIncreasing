class Solution {
public:
    vector<int> deckRevealedIncreasing(vector<int>& deck) {
        sort(deck.begin(), deck.end());
        
        vector<int> ans;
        
        while(!deck.empty()){
            if(!ans.empty()){
                ans.insert(ans.begin(), ans.back());
                ans.pop_back();
            }
            
            ans.insert(ans.begin(), deck.back());
            deck.pop_back();
        }
        
        return ans;
    }
};
