class Solution {
public:
string toBinary(int n) {
    if (n == 0) return "0";

    string bin = "";
    while (n > 0) {
        bin += (n % 2) + '0';
        n /= 2;
    }
    reverse(bin.begin(), bin.end());
    return bin;
}
    int minimumFlips(int n) {
        string binary=toBinary(n);
        string copy=binary;int res=0;
        reverse(binary.begin(),binary.end());
        for(int i=0;i<binary.size();i++){
            if(binary[i]!=copy[i]){
                res++;
            }
        }
        return res;
    }
};
