class Solution {
public:
    bool isPrime(int n) {
    if (n <= 1) return false;  
    if (n == 2 || n == 3) return true; 
    if (n % 2 == 0 || n % 3 == 0) return false;

    for (int i = 5; i <= std::sqrt(n); i += 6) {
        if (n % i == 0 || n % (i + 2) == 0)
            return false;
    }
    return true;
}
    bool checkPrimeFrequency(vector<int>& nums) {
        map<int,int>freq;
        for(auto ch:nums){
            freq[ch]++;
        }
        for(auto pair:freq){
            if(isPrime(pair.second))return true;
        }
        return false;
    }
};
