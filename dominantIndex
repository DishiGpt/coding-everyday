class Solution {
public:
    int dominantIndex(vector<int>& nums) {
        auto it = max_element(nums.begin(), nums.end());
        int index = distance(nums.begin(), it);
        int flag=1;
        for(int i=0;i<nums.size();i++){
            if(i!=index){
                if(*it< (2*nums[i])){
                    flag=0;
                    break;
                }
            }
        }
        if(flag)return index;
        return -1; 
    }
};
