class Solution {
public:
    vector<int> lastVisitedIntegers(vector<int>& nums) {
        vector<int>seen;
        vector<int>ans;
        int count=0;
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]>0){
                count=0;
                seen.insert(seen.begin(),nums[i]);
            }
            else{
                count++;
                if(count>seen.size()){
                    ans.push_back(-1);
                }
                else{
                    ans.push_back(seen[count-1]);
                }
            }
        }
        return ans;
    }
};
