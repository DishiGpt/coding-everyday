class Solution {
public:
    string triangleType(vector<int>& nums) {
        sort(nums.begin(), nums.end()); // Optional but helps ensure correct side comparisons
        int c = count(nums.begin(), nums.end(), nums[0]);
        bool what = false;

        // Triangle inequality condition (all 3 must hold)
        if (nums[0] + nums[1] > nums[2] &&
            nums[0] + nums[2] > nums[1] &&
            nums[1] + nums[2] > nums[0]) {
            what = true;
        }

        if (!what) {
            return "none";
        }

        if (nums[0] == nums[1] && nums[1] == nums[2]) {
            return "equilateral";
        }
        if (nums[0] == nums[1] || nums[1] == nums[2] || nums[0] == nums[2]) {
            return "isosceles";
        }
        return "scalene";
    }
};
