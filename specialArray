class Solution {
public:
    int specialArray(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int i=0;
        int n=nums.size();
        while(i<=n){
            int count=0;
            for(int c=0;c<n;c++){
                if(nums[c]>=i)count++;
            }
            if(count==i)return i;
            i++;
        }
        return -1;

    }
};
