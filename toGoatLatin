class Solution {
public:
    bool isVowel(char c){
        c=tolower(c);
        return c=='a'||c=='e'||c=='i'||c=='o'||c=='u';
    }
    string toGoatLatin(string sentence) {
        vector<string>s;
        stringstream ss(sentence);
        string word;
        while(ss>>word){
            s.push_back(word);
        }
        for(int i=0;i<s.size();i++){
            if(isVowel(s[i][0])){
                s[i]+="ma";
            }
            else{
                char temp=s[i][0];
                s[i].erase(0,1);
                s[i]+=temp;
                s[i]+="ma";
            }
            for (int add = 0; add <= i; add++) {
                s[i] += 'a';
            }
        }
        string ans;
        for(int i=0;i<s.size();i++){
            ans+=' ';
            ans+=s[i];
        }
        ans.erase(0,1);
        return ans;

    }
};
