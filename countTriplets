class Solution {
public:
    int countTriplets(vector<int>& arr) {
        int n = arr.size();

        vector<int> prefix(n, 0);

        prefix[0] = arr[0];

        for(int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] ^ arr[i];
        }

        int count = 0;

        for(int i = 0; i < n; i++) {
            for(int k = i; k < n; k++) {

                int xorr;

                if(i == 0)
                    xorr = prefix[k];
                else
                    xorr = prefix[k] ^ prefix[i - 1];

                if(xorr == 0) {
                    count += (k - i);
                }
            }
        }

        return count;
    }
};
