class Solution {
public:
    long long minSum(vector<int>& nums1, vector<int>& nums2) {
        long long sum1 = accumulate(nums1.begin(), nums1.end(), 0LL);
        long long sum2 = accumulate(nums2.begin(), nums2.end(), 0LL);
        int c1=count(nums1.begin(),nums1.end(),0);
        int c2=count(nums2.begin(),nums2.end(),0);
        long long min_sum1 = sum1 + c1;
        long long min_sum2 = sum2 + c2;
        
        if (c1 == 0 && c2 == 0) {
            return sum1 == sum2 ? sum1 : -1;
        } else if (c1 == 0) {
            if (sum1 >= min_sum2) {
                return sum1;
            } else {
                return -1;
            }
        } else if (c2 == 0) {
            if (sum2 >= min_sum1) {
                return sum2;
            } else {
                return -1;
            }
        } else {
            return max(min_sum1, min_sum2);
        }
    }
};
