class Solution {
public:
    int numWaterBottles(int numBottles, int numExchange) {
        int fullbottles=numBottles,emptybottles=numBottles;
        while(emptybottles>=numExchange){
            fullbottles++;
            emptybottles=emptybottles-numExchange+1;
        }
        return fullbottles;
    }
};
