class Solution {
public:
    int leastInterval(vector<char>& tasks, int n) {
        map<char,int>freq;
        for(char c:tasks){
            freq[c]++;
        }
        int maxFreq=INT_MIN;
        for(auto p:freq){
            maxFreq=max(maxFreq,p.second);
        }
        int countMax=0;
        for(auto p:freq){
            if(p.second==maxFreq){
                countMax++;
            }
        }
        int s=tasks.size();
        return max(s,((maxFreq - 1) * (n + 1) + countMax));
        
    }
};
