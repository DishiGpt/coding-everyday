class Solution {
public:
    vector<vector<int>> construct2DArray(vector<int>& original, int m, int n) {
        int s=original.size();
        if(s!=m*n)return {};
        vector<vector<int>> res(m,vector<int>(n,0));
        for(int i=0;i<s;i++){
            int row=i/n;
            int col=i%n;
            res[row][col]=original[i];
        }
        return res;
    }
};
