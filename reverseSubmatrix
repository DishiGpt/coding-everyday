class Solution {
public:
    vector<vector<int>> reverseSubmatrix(vector<vector<int>>& grid, int x, int y, int k) {
        int start = x;
        int end = x + k - 1;

        while (start < end) {
            for (int j = y; j <= y + k - 1; j++) {
                swap(grid[start][j], grid[end][j]);
            }
            start++;
            end--;
        }

        return grid;
    }
};
