class Solution {
public:
    bool containsPattern(vector<int>& arr, int m, int k) {
        
        for(int i = 0; i + m * k <= arr.size(); i++) {
            
            bool possible = true;
            
            for(int j = 0; j < m * (k - 1); j++) {
                if(arr[i + j] != arr[i + j + m]) {
                    possible = false;
                    break;
                }
            }
            
            if(possible)
                return true;
        }
        
        return false;
    }
};
