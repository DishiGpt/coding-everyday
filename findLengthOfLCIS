class Solution {
public:
    int findLengthOfLCIS(vector<int>& nums) {
        if(nums.size() == 0) return 0;

        int maxLen = 1;
        int currLen = 1;

        for(int i = 1; i < nums.size(); i++) {
            if(nums[i] > nums[i - 1]) {
                currLen++;               // increasing chain continues
            } else {
                currLen = 1;             // reset
            }
            maxLen = max(maxLen, currLen);
        }

        return maxLen;
    }
};
