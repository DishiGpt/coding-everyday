class Solution {
public:
    int arithmeticTriplets(vector<int>& nums, int diff) {
        map<vector<int>,int>freq;
        for(int i=0;i<nums.size();i++){
            for(int j=i+1;j<nums.size();j++){
                for(int k=j+1;k<nums.size();k++){
                    if(nums[j]-nums[i]==diff && nums[k]-nums[j]==diff){
                        vector<int>h;
                        h.push_back(nums[i]);
                        h.push_back(nums[j]);
                        h.push_back(nums[k]);
                        freq[h]++;
                    }
                }
            }
        }
        int total=0;
        for(auto ch:freq){
            total++;
        }
        return total;
    }
};
