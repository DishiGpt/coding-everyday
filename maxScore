class Solution {
public:
    int maxScore(string s) {
        int n=s.size();
        vector<int>prefix(n-1);
        vector<int>suffix(n-1);
        int sum=0;
        for(int i=0;i<n-1;i++){
            if(s[i]=='0'){
                sum+=1;
            }
            prefix[i]=sum;
        }
        sum=0;
        for(int i=n-2;i>=0;i--){
            if(s[i+1]=='1'){
                sum+=1;
            }
            suffix[i]=sum;
        }
        int score=INT_MIN;
        for(int i=0;i<n-1;i++){
            score=max(score,prefix[i]+suffix[i]);
        }
        return score;
    }
};
