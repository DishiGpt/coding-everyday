class Solution {
public:
    string smallestNumber(string pattern) {
        string result="";
        vector<int>num;
        int n=pattern.size();
        for(int i=1;i<=n+1;i++){
            num.push_back(i);
        }
        for(int i=0;i<n;i++){
            if(pattern[i]=='I'){
                result+=num.front()+'0';
                num.erase(num.begin());
            }
            else{
                string temp="";
                while(i<n&&pattern[i]=='D'){
                    temp+=num.front()+'0';
                    num.erase(num.begin());
                    i++;
                }
                temp += to_string(num.front());
                num.erase(num.begin());
                reverse(temp.begin(),temp.end());
                result+=temp;
            }
        }
        if (!num.empty()) {
            result += to_string(num.front());
        }
        return result;
    }
};
