class Solution {
public:
    int findLongestChain(vector<vector<int>>& pairs) {
        
        sort(pairs.begin(), pairs.end(), [](const vector<int>& a, const vector<int>& b) {
            return a[1] < b[1];
        });

        int chain = 0;
        int end = INT_MIN;

        for (int i = 0; i < pairs.size(); i++) {
            if (pairs[i][0] > end) {
                chain++;
                end = pairs[i][1];
            }
        }

        return chain;
    }
};
